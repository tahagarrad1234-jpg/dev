{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"pnpm --filter @workspace/api dev:local\" \"pnpm --filter @workspace/web dev\"",
    "dev:api": "pnpm --filter @workspace/api dev:local",
    "dev:web": "pnpm --filter @workspace/web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run"
  },
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
