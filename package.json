{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"pnpm --filter @workspace/api dev:local\" \"pnpm --filter @workspace/web dev\"",
    "dev:api": "pnpm --filter @workspace/api dev:local",
    "dev:web": "pnpm --filter @workspace/web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
