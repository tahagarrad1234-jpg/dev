# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Use the IPv4 session pooler (port 6543). The legacy db.<ref>.supabase.co host
# is IPv6-only on new projects and is not reachable from machines without IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# API and browser settings
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Used to seed the Supabase admin account on the first admin login
ADMIN_EMAIL=admin@amal.local
ADMIN_PASSWORD=admin1234
